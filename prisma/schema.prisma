// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  OWNER
  FAMILY_MEMBER
  CONTRACTOR
  SERVICE_PROVIDER
  ARCHITECT
  ADMIN
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum HouseMemberRole {
  OWNER
  FAMILY_MEMBER
  CONTRACTOR
  ARCHITECT
}

enum FeatureCategory {
  SECURITY
  SMART_HOME
  ENERGY
  WATER
  COMFORT
  EXTERIOR
  PREMIUM
}

enum HouseStageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  COMPLETED_WITH_WARNINGS
}

enum TaskType {
  MANDATORY
  RECOMMENDED
  OPTIONAL
}

enum HouseTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  BLOCKED
}

enum AlertType {
  DEPENDENCY
  DECISION
  WARNING
  BUDGET
  PROGRESS
  WEATHER
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MediaType {
  PHOTO
  VIDEO
}

enum ExpenseCategory {
  ELECTRICAL
  PLUMBING
  FLOORING
  PAINTING
  LABOUR
  MATERIALS
  OTHER
}

enum CostConfidence {
  LOW
  MEDIUM
  HIGH
}

enum ReviewReason {
  POOR_QUALITY
  DELAYED_WORK
  OVER_BUDGET
  POOR_COMMUNICATION
  OTHER
}

enum DocumentType {
  DRAWING
  INVOICE
  WARRANTY
  PLAN
  OTHER
}

enum WeatherAlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ============================================================
// CORE MODELS
// ============================================================

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  phoneNumber  String?
  profileImage String?
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  ownedHouses      House[]           @relation("HouseOwner")
  houseMemberships HouseMember[]
  notifications    Notification[]
  progressUpdates  ProgressUpdate[]
  verifications    ProgressVerification[]
  serviceProvider  ServiceProvider?
  auditLogs        AuditLog[]
  claimRequests    ClaimRequest[]

  // Business directory (optional associations; a listing never requires a user)
  businessLinks      BusinessUserLink[]
  businessAuditLogs  BusinessAuditLog[]

  @@map("users")
}

model HouseType {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  houses House[]

  @@map("house_types")
}

model House {
  id              String        @id @default(uuid())
  ownerId         String
  projectName     String
  city            String
  state           String
  country         String        @default("India")
  plotSize        Float?
  houseTypeId     String
  floors          Int           @default(1)
  bedrooms        Int           @default(2)
  bathrooms       Int           @default(2)
  parkingSpaces   Int           @default(1)
  currentProgress Float         @default(0)
  projectStatus   ProjectStatus @default(PLANNING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  owner         User           @relation("HouseOwner", fields: [ownerId], references: [id])
  houseType     HouseType      @relation(fields: [houseTypeId], references: [id])
  members       HouseMember[]
  houseProviders HouseProvider[]
  houseStages   HouseStage[]
  houseTasks    HouseTask[]
  houseFeatures HouseFeature[]
  houseDecisions HouseDecision[]
  houseAlerts   HouseAlert[]
  expenses      Expense[]
  documents     Document[]
  progressUpdates ProgressUpdate[]
  houseMilestones HouseMilestone[]
  weatherAlerts  WeatherAlert[]
  reviews        Review[]
  auditLogs      AuditLog[]

  @@map("houses")
}

model HouseMember {
  id       String          @id @default(uuid())
  houseId  String
  userId   String
  role     HouseMemberRole
  joinedAt DateTime        @default(now())

  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([houseId, userId])
  @@map("house_members")
}

model HouseProvider {
  id         String   @id @default(uuid())
  houseId    String
  providerId String
  assignedAt DateTime @default(now())

  house    House           @relation(fields: [houseId], references: [id], onDelete: Cascade)
  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([houseId, providerId])
  @@map("house_providers")
}

// ============================================================
// FEATURE SYSTEM
// ============================================================

model Feature {
  id          String          @id @default(uuid())
  name        String          @unique
  category    FeatureCategory
  description String?
  active      Boolean         @default(true)

  houseFeatures  HouseFeature[]
  featureTasks   FeatureTask[]
  featureDepsFrom FeatureDependency[] @relation("FeatureDependencyFrom")
  featureDepsTo   FeatureDependency[] @relation("FeatureDependencyTo")

  @@map("features")
}

model HouseFeature {
  id        String   @id @default(uuid())
  houseId   String
  featureId String
  enabled   Boolean  @default(true)
  addedAt   DateTime @default(now())

  house   House   @relation(fields: [houseId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id])

  @@unique([houseId, featureId])
  @@map("house_features")
}

// ============================================================
// STAGE & TASK SYSTEM
// ============================================================

model Stage {
  id           String  @id @default(uuid())
  name         String  @unique
  description  String?
  displayOrder Int
  active       Boolean @default(true)

  tasks       Task[]
  houseStages HouseStage[]
  decisions   Decision[]
  alerts      Alert[]
  costEstimates CostEstimate[]
  businessCategoryStages BusinessCategoryStage[]

  @@map("stages")
}

model HouseStage {
  id          String           @id @default(uuid())
  houseId     String
  stageId     String
  status      HouseStageStatus @default(NOT_STARTED)
  startedAt   DateTime?
  completedAt DateTime?

  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)
  stage Stage @relation(fields: [stageId], references: [id])

  @@unique([houseId, stageId])
  @@map("house_stages")
}

model Task {
  id          String   @id @default(uuid())
  stageId     String
  name        String
  description String?
  taskType    TaskType @default(MANDATORY)
  weight      Int      @default(10)
  active      Boolean  @default(true)

  stage      Stage      @relation(fields: [stageId], references: [id])
  houseTasks HouseTask[]
  depsFrom   TaskDependency[] @relation("TaskDependencyFrom")
  depsTo     TaskDependency[] @relation("TaskDependencyTo")
  featureTasks FeatureTask[]

  @@map("tasks")
}

model HouseTask {
  id          String          @id @default(uuid())
  houseId     String
  taskId      String
  status      HouseTaskStatus @default(PENDING)
  notes       String?
  completedAt DateTime?

  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)
  task  Task  @relation(fields: [taskId], references: [id])

  @@unique([houseId, taskId])
  @@map("house_tasks")
}

model TaskDependency {
  id              String @id @default(uuid())
  taskId          String
  dependsOnTaskId String

  task      Task @relation("TaskDependencyFrom", fields: [taskId], references: [id])
  dependsOn Task @relation("TaskDependencyTo", fields: [dependsOnTaskId], references: [id])

  @@unique([taskId, dependsOnTaskId])
  @@map("task_dependencies")
}

model FeatureTask {
  id        String @id @default(uuid())
  featureId String
  taskId    String

  feature Feature @relation(fields: [featureId], references: [id])
  task    Task    @relation(fields: [taskId], references: [id])

  @@unique([featureId, taskId])
  @@map("feature_tasks")
}

model FeatureDependency {
  id                String @id @default(uuid())
  featureId         String
  dependsOnFeatureId String

  feature   Feature @relation("FeatureDependencyFrom", fields: [featureId], references: [id])
  dependsOn Feature @relation("FeatureDependencyTo", fields: [dependsOnFeatureId], references: [id])

  @@unique([featureId, dependsOnFeatureId])
  @@map("feature_dependencies")
}

// ============================================================
// DECISION SYSTEM
// ============================================================

model Decision {
  id          String  @id @default(uuid())
  stageId     String
  title       String
  description String?
  required    Boolean @default(false)
  active      Boolean @default(true)

  stage          Stage           @relation(fields: [stageId], references: [id])
  houseDecisions HouseDecision[]

  @@map("decisions")
}

model HouseDecision {
  id            String    @id @default(uuid())
  houseId       String
  decisionId    String
  selectedValue String?
  notes         String?
  completedAt   DateTime?
  house    House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  decision Decision @relation(fields: [decisionId], references: [id])

  @@unique([houseId, decisionId])
  @@map("house_decisions")
}

// ============================================================
// ALERT SYSTEM
// ============================================================

model Alert {
  id          String        @id @default(uuid())
  stageId     String?
  type        AlertType
  title       String
  description String?
  severity    AlertSeverity @default(MEDIUM)
  active      Boolean       @default(true)

  stage       Stage?        @relation(fields: [stageId], references: [id])
  houseAlerts HouseAlert[]

  @@map("alerts")
}

model HouseAlert {
  id           String   @id @default(uuid())
  houseId      String
  alertId      String
  acknowledged Boolean  @default(false)
  createdAt    DateTime @default(now())

  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)
  alert Alert @relation(fields: [alertId], references: [id])

  @@map("house_alerts")
}

// ============================================================
// PROGRESS SYSTEM
// ============================================================

model ProgressUpdate {
  id          String   @id @default(uuid())
  houseId     String
  submittedBy String
  title       String
  description String?
  createdAt   DateTime @default(now())

  house        House                  @relation(fields: [houseId], references: [id], onDelete: Cascade)
  submitter    User                   @relation(fields: [submittedBy], references: [id])
  media        ProgressMedia[]
  verification ProgressVerification?
  @@map("progress_updates")
}

model ProgressMedia {
  id        String    @id @default(uuid())
  updateId  String
  fileUrl   String
  mediaType MediaType

  update ProgressUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)

  @@map("progress_media")
}

model ProgressVerification {
  id         String    @id @default(uuid())
  updateId   String    @unique
  verifiedBy String
  approved   Boolean   @default(false)
  feedback   String?
  verifiedAt DateTime  @default(now())

  update     ProgressUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  verifier   User           @relation(fields: [verifiedBy], references: [id])

  @@map("progress_verifications")
}

// ============================================================
// BUDGET SYSTEM
// ============================================================

model Expense {
  id        String          @id @default(uuid())
  houseId   String
  category  ExpenseCategory
  amount    Float
  notes     String?
  createdAt DateTime        @default(now())

  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@map("expenses")
}

model CostEstimate {
  id          String         @id @default(uuid())
  stageId     String
  city        String
  category    String
  minCost     Float
  maxCost     Float
  confidence  CostConfidence @default(MEDIUM)
  sourceCount Int            @default(0)

  stage Stage @relation(fields: [stageId], references: [id])

  @@map("cost_estimates")
}

// ============================================================
// SERVICE PROVIDER SYSTEM
// ============================================================

model ServiceCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  providerCategories ServiceProviderCategory[]
  businessCategoryMap BusinessLegacyCategoryMap?

  @@map("service_categories")
}

model ServiceProvider {
  id           String   @id @default(uuid())
  userId       String   @unique
  businessName String
  description  String?
  verified     Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  user          User                     @relation(fields: [userId], references: [id])
  categories    ServiceProviderCategory[]
  serviceAreas  ServiceArea[]
  houseProviders HouseProvider[]
  reviews       Review[]
  claimRequests ClaimRequest[]
  businessListing BusinessListing?

  @@map("service_providers")
}

model ServiceProviderCategory {
  id         String @id @default(uuid())
  providerId String
  categoryId String

  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id])

  @@unique([providerId, categoryId])
  @@map("service_provider_categories")
}

model ServiceArea {
  id         String @id @default(uuid())
  providerId String
  city       String
  radius     Float  @default(50)

  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, city])
  @@map("service_areas")
}

model ClaimRequest {
  id          String   @id @default(uuid())
  providerId  String
  claimantId  String
  status      String   @default("PENDING")
  adminNotes  String?
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?

  provider ServiceProvider @relation(fields: [providerId], references: [id])
  claimant User            @relation(fields: [claimantId], references: [id])

  @@map("claim_requests")
}

// ============================================================
// REVIEW SYSTEM
// ============================================================

model Review {
  id             String        @id @default(uuid())
  providerId     String
  houseId        String
  rating         Int           @default(5)
  wouldHireAgain Boolean
  reason         ReviewReason?
  createdAt      DateTime      @default(now())

  provider ServiceProvider @relation(fields: [providerId], references: [id])
  house    House           @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

// ============================================================
// DOCUMENT VAULT
// ============================================================

model Document {
  id           String       @id @default(uuid())
  houseId      String
  name         String
  documentType DocumentType @default(OTHER)
  fileUrl      String
  uploadedAt   DateTime     @default(now())

  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@map("documents")
}

// ============================================================
// NOTIFICATION SYSTEM
// ============================================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ============================================================
// MILESTONE SYSTEM
// ============================================================

model Milestone {
  id          String  @id @default(uuid())
  title       String  @unique
  description String?
  active      Boolean @default(true)

  houseMilestones HouseMilestone[]

  @@map("milestones")
}

model HouseMilestone {
  id          String   @id @default(uuid())
  houseId     String
  milestoneId String
  achievedAt  DateTime @default(now())

  house     House     @relation(fields: [houseId], references: [id], onDelete: Cascade)
  milestone Milestone @relation(fields: [milestoneId], references: [id])

  @@unique([houseId, milestoneId])
  @@map("house_milestones")
}

// ============================================================
// WEATHER SYSTEM (future-ready)
// ============================================================

model WeatherAlert {
  id           String                @id @default(uuid())
  houseId      String
  alertMessage String
  severity     WeatherAlertSeverity @default(MEDIUM)
  createdAt    DateTime             @default(now())

  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@map("weather_alerts")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  houseId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  house House? @relation(fields: [houseId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}


// ============================================================
// BUSINESS DIRECTORY (Vendor Intelligence Engine, Phase 1 foundation)
//
// A BusinessListing is a real-world business. It exists independently of any
// ConstructionDekho user account. Accounts are linked optionally through
// BusinessUserLink. The legacy ServiceProvider model is untouched and remains
// the source of truth for existing routes until they are migrated.
// All tables are additive: no existing table is altered, renamed or dropped.
// ============================================================

enum BusinessListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  SUPPRESSED
  REMOVED
}

enum BusinessVerificationStatus {
  UNVERIFIED
  VERIFIED
  REVOKED
}

// Promotion is deliberately independent of verification.
enum BusinessPromotionStatus {
  NONE
  FEATURED
}

enum BusinessUserRelation {
  LEGACY_ACCOUNT
  OWNER_CLAIM
  REPRESENTATIVE
}

enum BusinessServiceAreaType {
  PINCODE
  LOCALITY
  CITY
  DISTRICT
  STATE
  RADIUS
  NATIONWIDE
}

enum BusinessFieldOrigin {
  SOURCE_PROVIDED
  VENDOR_SUPPLIED
  ADMIN_CONFIRMED
  ADMIN_EDITED
  MIGRATED_LEGACY
}

enum BusinessDisplayPolicy {
  PUBLIC
  INTERNAL_ONLY
  RESTRICTED
}

enum SourcePolicyReviewStatus {
  NEEDS_HUMAN_REVIEW
  APPROVED
  BLOCKED
}

enum BusinessSourceRecordStatus {
  ACTIVE
  STALE
  REMOVED_AT_SOURCE
  SUPPRESSED
}

enum BusinessImageStatus {
  PENDING
  APPROVED
  REJECTED
}

model BusinessListing {
  id                    String                     @id @default(uuid())
  slug                  String                     @unique
  name                  String
  description           String?
  listingStatus         BusinessListingStatus      @default(DRAFT)
  verificationStatus    BusinessVerificationStatus @default(UNVERIFIED)
  verificationChangedAt DateTime?
  promotionStatus       BusinessPromotionStatus    @default(NONE)
  website               String?
  phone                 String?
  email                 String?
  operatingHours        Json?
  dataQualityScore      Float?
  // True for demo/test records. They must never be presented as discovered real businesses.
  isFixture             Boolean                    @default(false)
  // Compatibility link to the legacy provider this listing was backfilled from.
  legacyServiceProviderId String?                  @unique
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  legacyProvider  ServiceProvider?          @relation(fields: [legacyServiceProviderId], references: [id], onDelete: SetNull)
  categories      BusinessListingCategory[]
  locations       BusinessLocation[]
  serviceAreas    BusinessServiceArea[]
  sourceRecords   BusinessSourceRecord[]
  fieldProvenance BusinessFieldProvenance[]
  images          BusinessImage[]
  userLinks       BusinessUserLink[]
  auditLogs       BusinessAuditLog[]

  @@index([listingStatus])
  @@index([verificationStatus])
  @@index([name])
  @@map("business_listings")
}

// Optional association between a registered user and a listing. Not required for a listing to exist.
model BusinessUserLink {
  id         String               @id @default(uuid())
  businessId String
  userId     String
  relation   BusinessUserRelation
  createdAt  DateTime             @default(now())

  business BusinessListing @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_user_links")
}

model BusinessCategory {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String
  description     String?
  parentId        String?
  isActive        Boolean  @default(true)
  displayOrder    Int      @default(0)
  synonyms        String[]
  discoveryTerms  String[]
  defaultRadiusKm Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parent           BusinessCategory?                   @relation("BusinessCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children         BusinessCategory[]                  @relation("BusinessCategoryTree")
  listings         BusinessListingCategory[]
  stageMappings    BusinessCategoryStage[]
  externalMappings BusinessCategoryExternalMapping[]
  legacyMaps       BusinessLegacyCategoryMap[]

  @@index([parentId])
  @@index([isActive, displayOrder])
  @@map("business_categories")
}

// Categories and construction stages are separate; many-to-many with a relevance weight (ranking only, never filtering).
model BusinessCategoryStage {
  id         String @id @default(uuid())
  categoryId String
  stageId    String
  relevance  Int    @default(1)

  category BusinessCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  stage    Stage            @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([categoryId, stageId])
  @@index([stageId])
  @@map("business_category_stages")
}

// Proposed mapping to an external source's own category/type code (e.g. google_places, osm). Unverified until reviewed.
model BusinessCategoryExternalMapping {
  id           String  @id @default(uuid())
  categoryId   String
  sourceKey    String
  externalCode String
  externalLabel String?

  category BusinessCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Explicit short name: the auto-generated one exceeds PostgreSQL's 63-character identifier limit.
  @@unique([categoryId, sourceKey, externalCode], map: "business_cat_ext_map_cat_src_code_key")
  @@index([sourceKey, externalCode])
  @@map("business_category_external_mappings")
}

// Records which new category each legacy ServiceCategory was mapped to.
model BusinessLegacyCategoryMap {
  id                String   @id @default(uuid())
  serviceCategoryId String   @unique
  categoryId        String
  createdAt         DateTime @default(now())

  serviceCategory ServiceCategory  @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)
  category        BusinessCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@map("business_legacy_category_maps")
}

model BusinessListingCategory {
  id         String   @id @default(uuid())
  businessId String
  categoryId String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  business BusinessListing  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category BusinessCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([businessId, categoryId])
  @@index([categoryId])
  @@map("business_listing_categories")
}

// Where the business physically is. Separate from where it serves (BusinessServiceArea).
model BusinessLocation {
  id              String   @id @default(uuid())
  businessId      String
  label           String?
  addressLine1    String?
  addressLine2    String?
  locality        String?
  city            String?
  district        String?
  state           String?
  pincode         String?
  country         String   @default("IN")
  latitude        Float?
  longitude       Float?
  geocodeAccuracy String?
  isPrimary       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business BusinessListing @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([pincode])
  @@index([state, city])
  @@index([latitude, longitude])
  @@map("business_locations")
}

// Where the business serves. Many per business; independent of its physical location.
model BusinessServiceArea {
  id              String                  @id @default(uuid())
  businessId      String
  areaType        BusinessServiceAreaType
  pincode         String?
  locality        String?
  city            String?
  district        String?
  state           String?
  centerLatitude  Float?
  centerLongitude Float?
  radiusKm        Float?
  createdAt       DateTime                @default(now())

  business BusinessListing @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([areaType, pincode])
  @@index([state, city])
  @@map("business_service_areas")
}

// Registry of data sources and the handling rules that apply to each. Defaults are the most restrictive.
model BusinessDataSource {
  id                  String                   @id @default(uuid())
  key                 String                   @unique
  name                String
  kind                String
  licenceBasis        String?
  licenceUrl          String?
  attributionText     String?
  permittedFields     String[]
  maxRetentionDays    Int?
  publicDisplayAllowed Boolean                 @default(false)
  imagesAllowed       Boolean                  @default(false)
  refreshIntervalDays Int?
  deletionObligations String?
  rateLimitNotes      String?
  policyReviewStatus  SourcePolicyReviewStatus @default(NEEDS_HUMAN_REVIEW)
  policyReviewedAt    DateTime?
  notes               String?
  isActive            Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  sourceRecords BusinessSourceRecord[]
  provenance    BusinessFieldProvenance[]
  images        BusinessImage[]

  @@map("business_data_sources")
}

// A record in an external source. Not the business itself; keeps source identifiers apart from profile data.
model BusinessSourceRecord {
  id           String                     @id @default(uuid())
  dataSourceId String
  businessId   String?
  externalId   String
  externalUrl  String?
  status       BusinessSourceRecordStatus @default(ACTIVE)
  // Only populated where the source's policy allows persistence. Null by default.
  rawPayload   Json?
  obtainedAt   DateTime                   @default(now())
  lastCheckedAt DateTime?
  retainUntil  DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  dataSource BusinessDataSource @relation(fields: [dataSourceId], references: [id], onDelete: Restrict)
  business   BusinessListing?   @relation(fields: [businessId], references: [id], onDelete: SetNull)
  provenance BusinessFieldProvenance[]

  @@unique([dataSourceId, externalId])
  @@index([businessId])
  @@map("business_source_records")
}

model BusinessFieldProvenance {
  id             String                @id @default(uuid())
  businessId     String
  fieldName      String
  dataSourceId   String
  sourceRecordId String?
  origin         BusinessFieldOrigin
  licenceBasis   String?
  displayPolicy  BusinessDisplayPolicy @default(INTERNAL_ONLY)
  obtainedAt     DateTime              @default(now())
  lastCheckedAt  DateTime?
  retainUntil    DateTime?
  refreshBy      DateTime?
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  business     BusinessListing       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dataSource   BusinessDataSource    @relation(fields: [dataSourceId], references: [id], onDelete: Restrict)
  sourceRecord BusinessSourceRecord? @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)

  @@unique([businessId, fieldName, dataSourceId])
  @@index([businessId])
  @@map("business_field_provenance")
}

// Only licensed or permissioned images may be stored or shown. Otherwise the UI uses a category placeholder.
model BusinessImage {
  id                 String              @id @default(uuid())
  businessId         String
  storageKey         String?
  url                String?
  dataSourceId       String?
  licence            String?
  permissionEvidence String?
  attribution        String?
  allowedUse         String?
  altText            String?
  status             BusinessImageStatus @default(PENDING)
  isPrimary          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  business   BusinessListing    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dataSource BusinessDataSource? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@map("business_images")
}

// Sensitive administrative actions: publish/reject, merge, edit, verification, removal, category and promotion changes.
model BusinessAuditLog {
  id         String   @id @default(uuid())
  businessId String?
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  business BusinessListing? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  actor    User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@map("business_audit_logs")
}
